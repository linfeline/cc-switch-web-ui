# cc-switch-web-ui Backend Configuration
# Copy this file to .env and update values as needed

# ===========================================
# Server Configuration
# ===========================================

# Port to run the server on (default: 33010)
PORT=33010

# Host to bind the server to (default: 0.0.0.0)
# Use 127.0.0.1 for localhost only
HOST=0.0.0.0

# Node environment (development, production, test)
NODE_ENV=development

# ===========================================
# Authentication
# ===========================================

# Admin password for API authentication
# If not set, authentication is disabled (not recommended for production)
# This password is used as the Bearer token for API requests
ADMIN_PASSWORD=admin123

# ===========================================
# CORS Configuration
# ===========================================

# Allowed origins for CORS (default: * for all origins)
# For production, set to your frontend URL(s)
# Example: https://example.com,https://app.example.com
CORS_ORIGIN=*

# ===========================================
# cc-switch CLI Configuration
# ===========================================

# Path to the cc-switch binary (recommended).
# Defaults (first existing): $CC_SWITCH_PATH → ~/.local/bin/cc-switch → /usr/local/bin/cc-switch → PATH
# CC_SWITCH_PATH=/usr/local/bin/cc-switch

# Optional: isolate cc-switch data directory (DB, settings, skills).
# When unset, the CLI uses ~/.cc-switch
# For tests/sandbox ALWAYS set this to a temporary directory — never point write tests at the real home DB.
# CC_SWITCH_CONFIG_DIR=/tmp/cc-switch-web-sandbox

# ===========================================
# Optional Features
# ===========================================

# Enable debug logging (true/false)
DEBUG=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info
